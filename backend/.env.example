# Backend environment variables (copy to `.env` and fill values)

# Server
PORT=8001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Production CORS allowlist
# - You can keep CLIENT_URL for a single origin, or use a comma-separated list
#   via CLIENT_URLS / ALLOWED_ORIGINS.
# - If deploying frontend on Vercel, either add your exact domain like
#   https://8-vingo-m793.vercel.app to CLIENT_URL(S), OR set ALLOW_VERCEL_APP=true
#   to allow any https://*.vercel.app origin.
#
# CLIENT_URLS=https://8-vingo-m793.vercel.app
# ALLOWED_ORIGINS=https://8-vingo-m793.vercel.app
# ALLOW_VERCEL_APP=false

# Database
MONGODB_URL=mongodb://127.0.0.1:27017/vingo

# Auth
JWT_SECRET=change_me

# Optional: Online image auto-search (Pexels)
# If empty, creating item/shop without an uploaded image will return 400.
PEXELS_API_KEY=

# Optional: Email (OTP) via Gmail
EMAIL=
PASS=

# Optional: Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Cloudinary (recommended for production image persistence)
# If set, uploaded shop/item images will be uploaded to Cloudinary and MongoDB
# will store a stable https URL instead of a local /public path.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: folder name inside Cloudinary
CLOUDINARY_FOLDER=vingo
